# ---- Open Cloud environment ----
# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# SQLite file (development default). Data directory is created automatically.
DATABASE_PATH=./data/opencloud.db

# Optional PostgreSQL URL. If set AND pg is available, the app logs a migration
# note. First version ships with SQLite (real DB, file-backed). The portable
# schema for PostgreSQL is in database/schema.postgres.sql.
# DATABASE_URL=postgres://user:pass@localhost:5432/opencloud

# Required in production. Random 32+ char string for signing sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# Required in production. 64 hex chars (32 bytes) used for AES-256-GCM
# encryption of Telegram bot tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Telegram Login (official Telegram Login Widget) ----
# Bot used ONLY to verify "Login with Telegram" signatures.
# Create via @BotFather, then set the bot domain to your app origin.
# https://core.telegram.org/widgets/login
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_NAME=

# Base for Telegram Bot API (override for tests/mocks only)
# TELEGRAM_API_BASE=https://api.telegram.org

# Telegram Bot API file size limit for bots (default 50 MiB).
# Bots cannot upload/download files larger than this via Bot API.
# MAX_UPLOAD_BYTES=52428800

# Development-only local login (clearly labelled in UI, disabled in
# production). Useful before Telegram Login is configured.
# DEV_ALLOW_LOCAL_LOGIN=true
